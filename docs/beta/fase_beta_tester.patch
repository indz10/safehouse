diff --git a/p102_beta.js b/p102_beta.js
new file mode 100644
index 0000000..b032e6b
--- /dev/null
+++ b/p102_beta.js
@@ -0,0 +1,47 @@
+<script>
+/* =========================================================
+   🧪 BETA (Fase 48, migrazione 039)
+   - 🐞 Segnala un problema (menu ☰, benvenuto, 🩺 Controlla il mio gioco): betaSheet → world_segnala(testo, dati).
+     Dati tecnici allegati se il tester lo lascia spuntato: versione, pagina e scheda aperte, telefono/browser,
+     schermo, rete, ultimi errori (BETA.err). Mai posizione, mai foto.
+   - Benvenuto ai tester (betaWelcome): una volta per account, quando gioca già nel mondo (zsh_beta1_<id>).
+   - Amministratore: in fondo a betaSheet l'elenco delle segnalazioni (world_segnalazioni_admin) con ✅ Risolta.
+   ========================================================= */
+const BETA={err:[]};
+window.addEventListener('error',e=>{try{BETA.err.push(String(e.message||'').slice(0,160)+' @'+String(e.filename||'').split('/').pop()+':'+e.lineno);BETA.err=BETA.err.slice(-5);}catch(x){}});
+window.addEventListener('unhandledrejection',e=>{try{BETA.err.push('promise: '+String(e.reason&&e.reason.message||e.reason||'').slice(0,160));BETA.err=BETA.err.slice(-5);}catch(x){}});
+function betaDati(){const sh=document.querySelector('#sheet.open .sheet-h h3');
+  return{versione:String(typeof APPV!=='undefined'?APPV:''),pagina:S.tab||'',scheda:sh?sh.textContent.slice(0,80):'',dove:typeof zWhere==='function'?zWhere():'',
+    ua:navigator.userAgent.slice(0,200),schermo:innerWidth+'×'+innerHeight,rete:navigator.onLine?'online':'offline',server:String(window.SB_STATO||''),errori:BETA.err.slice()};}
+const BETA_TIPI=[['🐞','Qualcosa non funziona'],['🎨','Grafica storta o coperta'],['🤔','Non ho capito cosa fare'],['💡','Idea o consiglio']];
+async function betaSheet(){const prima=document.querySelector('#sheet.open .sheet-h h3');const d=betaDati();if(prima)d.scheda=prima.textContent.slice(0,80);
+  openSheet('🐞 Segnala un problema',`<p class="muted" style="font-size:14px">Stai provando la <b>beta</b>: ogni segnalazione ci aiuta a sistemare il gioco prima dell’uscita. Scrivi cosa stavi facendo e cosa è successo.</p>
+    <div class="betatipi">${BETA_TIPI.map((t,i)=>`<button type="button" class="${i?'':'on'}" data-btip="${i}">${t[0]} ${esc(t[1])}</button>`).join('')}</div>
+    <textarea class="betatxt" maxlength="2000" rows="5" placeholder="Es.: nella Lente il tasto SPARA non risponde quando…"></textarea>
+    <label class="betachk"><input type="checkbox" checked data-bdati> Allega i dati tecnici (versione, pagina, telefono, ultimi errori: niente posizione)</label>
+    <button class="btn wide" data-bsend>📨 Manda la segnalazione</button>
+    <p class="muted" style="font-size:12.5px;margin-top:8px">Pagina: ${esc(d.pagina||'-')}${d.scheda?' · '+esc(d.scheda):''} · versione ${esc(d.versione)}</p><div class="betaadm"></div>`,c=>{
+    let tip=0;c.querySelectorAll('[data-btip]').forEach(b=>b.onclick=()=>{tip=+b.dataset.btip;c.querySelectorAll('[data-btip]').forEach(x=>x.classList.toggle('on',x===b));});
+    c.querySelector('[data-bsend]').onclick=async ev=>{const t=c.querySelector('.betatxt').value.trim();if(t.length<3){toast('Scrivi almeno qualche parola');return;}
+      ev.target.disabled=true;const dati=c.querySelector('[data-bdati]').checked?d:{versione:d.versione};dati.tipo=BETA_TIPI[tip][1];
+      try{const{data,error}=await SB.rpc('world_segnala',{p_testo:BETA_TIPI[tip][0]+' '+t,p_dati:dati});if(error)throw error;toast(data.msg||'Grazie!');if(data.ok){closeSheet();return;}}
+      catch(e){toast('Non riuscito: controlla la rete e riprova');}ev.target.disabled=false;};
+    betaAdmin(c.querySelector('.betaadm'));});}
