+-- =====================================================================
+-- ZombieSafeHouse · MIGRAZIONE 039 — 🐞 SEGNALA UN PROBLEMA (BETA, 19/11)
+-- I tester scrivono cosa non va dal menu ☰ → 🐞 Segnala un problema. L'app aggiunge da sola: versione, pagina aperta,
+-- telefono/browser, ultimi errori. Nessuna posizione e nessuna foto.
+-- world_segnala(testo, dati): max 20 al giorno a testa. L'amministratore (tabella admins) le legge con
+-- world_segnalazioni_admin() e le chiude con world_segnalazione_stato(id, stato).
+-- Per leggerle dall'SQL Editor: select * from world_segnalazioni order by created_at desc;
+-- Si può eseguire più volte.
+-- =====================================================================
+create table if not exists public.world_segnalazioni (
+  id bigserial primary key,
+  user_id uuid references auth.users(id) on delete set null,
+  testo text not null,
+  dati jsonb not null default '{}'::jsonb,
+  stato text not null default 'nuova' check (stato in ('nuova','vista','risolta')),
+  created_at timestamptz not null default now()
+);
+alter table public.world_segnalazioni enable row level security;
+create index if not exists world_segnalazioni_at on public.world_segnalazioni(created_at desc);
+
+create or replace function public.world_segnala(p_testo text, p_dati jsonb) returns json
+language plpgsql security definer set search_path to 'public' as $$
+declare me uuid := auth.uid(); t text := btrim(coalesce(p_testo, '')); nid bigint;
+begin
+  if length(t) < 3 then return json_build_object('ok', false, 'msg', 'Scrivi almeno qualche parola'); end if;
+  if me is not null and (select count(*) from public.world_segnalazioni where user_id = me and created_at > now() - interval '1 day') >= 20 then
+    return json_build_object('ok', false, 'msg', 'Hai già mandato 20 segnalazioni oggi: grazie! Riprova domani');
+  end if;
+  insert into public.world_segnalazioni(user_id, testo, dati)
+    values (me, left(t, 2000), coalesce(p_dati, '{}'::jsonb) - 'lat' - 'lon')
+    returning id into nid;
+  return json_build_object('ok', true, 'id', nid, 'msg', '🐞 Grazie! Segnalazione n° ' || nid || ' ricevuta');
+end $$;
+
+create or replace function public.world_segnalazioni_admin() returns json
+language sql stable security definer set search_path to 'public' as $$
+  select case when not public.is_admin() then '[]'::json else coalesce((select json_agg(x order by x.created_at desc) from (
+    select s.id, s.testo, s.dati, s.stato, s.created_at, p.nick
+    from public.world_segnalazioni s left join public.profili_pubblici p on p.user_id = s.user_id
+    order by s.created_at desc limit 200) x), '[]'::json) end; $$;
+
+create or replace function public.world_segnalazione_stato(p_id bigint, p_stato text) returns json
+language plpgsql security definer set search_path to 'public' as $$
+begin
+  if not public.is_admin() then return json_build_object('ok', false, 'msg', 'solo admin'); end if;
+  if p_stato not in ('nuova','vista','risolta') then return json_build_object('ok', false, 'msg', 'stato?'); end if;
+  update public.world_segnalazioni set stato = p_stato where id = p_id;
+  return json_build_object('ok', true);
+end $$;
+
+revoke all on function public.world_segnala(text, jsonb) from public, anon;
+grant execute on function public.world_segnala(text, jsonb) to authenticated;
+revoke all on function public.world_segnalazioni_admin() from public, anon;
+grant execute on function public.world_segnalazioni_admin() to authenticated;
+revoke all on function public.world_segnalazione_stato(bigint, text) from public, anon;
+grant execute on function public.world_segnalazione_stato(bigint, text) to authenticated;
+
+-- controllo: deve dire "segnalazioni pronte"
+select case when exists (select 1 from pg_proc where proname = 'world_segnala') then 'segnalazioni pronte' else 'qualcosa manca' end as esito;
